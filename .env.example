# Supabase (pre-configured - do not change)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Razorpay
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Dropshipping suppliers (server-only; never prefix these with NEXT_PUBLIC_)
SHESCALE_API_KEY=sk_live_replace_when_available
# Server-only reseller access token for product detail reads; public list needs none.
SHESCALE_ACCESS_TOKEN=
DROPSHIP_DISPATCH_SECRET=generate_a_long_random_secret


# Resend (for transactional emails)
RESEND_API_KEY=your_resend_api_key
BREVO_API_KEY=your_brevo_api_key
CRON_SECRET=generate_a_long_random_secret

# Site URL
NEXT_PUBLIC_SITE_URL=https://sriboutique.com
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=replace_with_search_console_token

# Google OAuth (configured in Supabase dashboard)
# Make sure to add Google as an auth provider in your Supabase project settings
